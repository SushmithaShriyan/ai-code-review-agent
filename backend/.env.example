# Copy this file to .env and fill in real values. Never commit the real .env file.

# GitHub - create a Personal Access Token (classic) with repo scope for local dev,
# or a GitHub App installation token for production. See README for steps.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# The secret you set when creating the webhook on GitHub - used to verify
# incoming requests really come from GitHub.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# OpenAI API key - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# MongoDB - use a free MongoDB Atlas cluster, or local MongoDB for dev
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=code_review_agent

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
